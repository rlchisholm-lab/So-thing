{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve Cork7",
            "type": "shell",
            "command": "echo 'Starting Cork7 server' && python3 -m http.server 8000 --bind 0.0.0.0",
            "isBackground": true,
            "problemMatcher": {
                "owner": "cork7-server",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Starting Cork7 server$",
                    "endsPattern": "^Serving HTTP on"
                }
            }
        }
    ]
}
